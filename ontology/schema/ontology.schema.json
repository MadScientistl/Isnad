{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amarh ontology",
  "type": "object",
  "required": [
    "version",
    "namespace",
    "objectTypes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^https?://.*[#/]$"
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "string"
          }
        }
      }
    },
    "objectTypes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "properties": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^(string|int|float|bool|timestamp|point|linestring)!?$"
                },
                {
                  "type": "object",
                  "required": [
                    "enum"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "enum": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "params": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "boolean"
              },
              "approvers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              },
              "exempt": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              }
            }
          },
          "bind": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "expr"
              ],
              "additionalProperties": false,
              "properties": {
                "expr": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": false,
              "properties": {
                "modify": {
                  "type": "object",
                  "required": [
                    "type",
                    "id",
                    "set"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "set": {
                      "type": "object",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "create": {
                  "type": "object",
                  "required": [
                    "type",
                    "set"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "as": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "set": {
                      "type": "object",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "delete": {
                  "type": "object",
                  "required": [
                    "type",
                    "id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                },
                "link": {
                  "$ref": "#/$defs/linkRule"
                },
                "unlink": {
                  "$ref": "#/$defs/linkRule"
                }
              }
            }
          },
          "function": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "webhooks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          },
          "rollback": {
            "enum": [
              "compensate",
              "irreversible"
            ]
          }
        }
      }
    },
    "linkTypes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "cardinality": {
            "enum": [
              "many-to-many",
              "many-to-one",
              "one-to-many",
              "one-to-one"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "transitive": {
            "type": "boolean"
          },
          "inverse": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "types": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Z][A-Za-z0-9]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "read": {
                      "type": "boolean"
                    },
                    "write": {
                      "type": "boolean"
                    },
                    "where": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mask": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "uniqueItems": true
                    }
                  }
                }
              }
            ]
          },
          "links": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              }
            ]
          },
          "actions": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              }
            ]
          },
          "approves": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              }
            ]
          },
          "region": {
            "enum": [
              "APAC",
              "EMEA",
              "AMER"
            ]
          }
        }
      }
    },
    "webhooks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "url_env"
        ],
        "additionalProperties": false,
        "properties": {
          "url_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "method": {
            "enum": [
              "POST",
              "PUT"
            ]
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "linkRule": {
      "type": "object",
      "required": [
        "link",
        "src",
        "dst"
      ],
      "additionalProperties": false,
      "properties": {
        "link": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "dst": {
          "type": "string"
        }
      }
    }
  }
}
