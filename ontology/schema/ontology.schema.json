{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amarh ontology",
  "type": "object",
  "required": ["version", "namespace", "objectTypes"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "namespace": {"type": "string", "pattern": "^https?://.*[#/]$"},
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {"extends": {"type": "string"}}
      }
    },
    "objectTypes": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Za-z0-9]*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "properties": {
            "type": "object",
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
            "additionalProperties": {
              "oneOf": [
                {"type": "string", "pattern": "^(string|int|float|bool|timestamp|point|linestring)!?$"},
                {"type": "object", "required": ["enum"], "additionalProperties": false,
                 "properties": {"enum": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
                                "required": {"type": "boolean"}}}
              ]
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "params": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
                     "additionalProperties": {"type": "string"}},
          "description": {"type": "string"},
          "writes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "linkTypes": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object", "required": ["from", "to"], "additionalProperties": false,
        "properties": {
          "from": {"type": "string"}, "to": {"type": "string"},
          "cardinality": {"enum": ["many-to-many", "many-to-one", "one-to-many", "one-to-one"]},
          "required": {"type": "boolean"},
          "transitive": {"type": "boolean"},
          "inverse": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    }
  }
}
