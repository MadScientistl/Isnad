# Copy to .env or export in your shell. Nothing here is a secret; real keys never go in git.
# Defaults shown are what the code uses when the variable is unset. Grouped as in README "Configuration".

# --- database -------------------------------------------------------------------------------
# ISNAD_DSN=postgresql://isnad:isnad@localhost:55441/isnad   # docker compose postgres
# ISNAD_SCHEMA=demo            # schema the API serves (seed and API must use the same)
# ISNAD_TEST_DSN=              # tests only; defaults to ISNAD_DSN

# --- API ------------------------------------------------------------------------------------
# ISNAD_ONTOLOGY=ontology/supply_chain.yaml
# ISNAD_BUILD_DIR=build/       # compiled shapes/ttl (workspaces use workspaces/<slug>/build)
# ISNAD_DEFAULT_ROLE=          # dev only: role used when the x-role header is missing (auth off)
# ISNAD_ALLOW_RESET=0          # 1 lets POST /sim/control {"reset":true} delete all data in the schema
# ISNAD_ALLOW_IMPORT=0         # 1 enables /ingest and /ontology admin routes; with auth off ANYONE who can reach the port can import: bind 127.0.0.1
# ISNAD_PIPELINE=1             # 0 disables the Oxigraph sync pipeline
# ISNAD_SIM_AUTOSTART=0
# ISNAD_MAX_BODY_BYTES=2097152 # request body limit (2 MiB)
# ISNAD_MAX_PROPS_BYTES=65536

# --- token authentication: OPTIONAL, OFF BY DEFAULT, EXPERIMENTAL ---------------------------
# Default mode is the UI role switcher: the role is an unauthenticated x-role header (see README, Known limitations).
# ISNAD_AUTH=0                 # 1 = signed bearer tokens, x-role ignored
# ISNAD_AUTH_SECRET=           # required with ISNAD_AUTH=1, >= 32 bytes, e.g. `openssl rand -hex 32`
# ISNAD_USERS_FILE=            # JSON users file; create one with `python scripts/make_users.py users.json`
# ISNAD_AUTH_TTL_H=12

# --- agent (runtime agent) --------------------------------------------------------------------
# ANTHROPIC_API_KEY=           # needed for the real model; without it /agent/runs returns 503
# ISNAD_AGENT_MODEL=           # model id
# ISNAD_AGENT_MAX_CONCURRENT=1
# ISNAD_AGENT_RUNS_PER_MIN=6
# ISNAD_AGENT_MAX_GLOBAL=4
# ISNAD_AGENT_DAILY_USD=5
# ISNAD_PROPOSAL_TTL_H=24
# ISNAD_EVAL_MODEL=            # model used by `python -m evals --mode live`

# --- scenarios --------------------------------------------------------------------------------
# ISNAD_SCN_MAX_PER_USER=5
# ISNAD_SCN_MAX_AGENT_PER_USER=5
# ISNAD_SCN_MAX_PER_RUN=3
# ISNAD_SCN_MAX_GLOBAL=20
# ISNAD_SCN_TTL_H=168
# ISNAD_SCN_MAX_ROWS=50000
# ISNAD_SCN_SIM_MAX_DAYS=90

# --- ontology import (ingest) -------------------------------------------------------------------
# ISNAD_INGEST_DIR=var/ingest          # stored uploads
# ISNAD_WORKSPACES_DIR=workspaces      # imported workspaces
# ISNAD_MAX_UPLOAD_BYTES=20971520
# ISNAD_IMPORT_SOURCES=                # named server-side sources: name=postgresql://... or name=sqlite:/abs/path
# ISNAD_ONTOLOGY_SELF_APPROVE=0        # dev only: lets the proposer approve an ontology change

# --- webhooks (action outbox) -------------------------------------------------------------------
# ISNAD_WEBHOOK_SECRET=        # required for delivery
# ISNAD_WEBHOOK_OPS_URL=       # url_env targets used by ontology/supply_chain.yaml
# ISNAD_WEBHOOK_FINANCE_URL=
# ISNAD_OUTBOX_WORKER=1        # 0 disables delivery
# ISNAD_OUTBOX_INTERVAL_S=
