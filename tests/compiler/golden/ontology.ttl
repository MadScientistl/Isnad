@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://example.org/sc#> .

<https://example.org/sc> a owl:Ontology .

sc:Warehouse a owl:Class ;
    rdfs:subClassOf sc:Facility .

sc:operated_by a owl:ObjectProperty ;
    rdfs:domain sc:Shipment ;
    rdfs:range sc:Carrier .

sc:ships_via a owl:ObjectProperty ;
    rdfs:domain sc:Shipment ;
    rdfs:range sc:Port .

sc:Carrier a owl:Class .

sc:Port a owl:Class ;
    rdfs:subClassOf sc:Facility .

sc:supplied_by a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain sc:Supplier ;
    rdfs:range sc:Supplier ;
    owl:inverseOf sc:supplies .

sc:supplies a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain sc:Supplier ;
    rdfs:range sc:Supplier ;
    owl:inverseOf sc:supplied_by .

sc:Facility a owl:Class .

sc:Shipment a owl:Class .

sc:Supplier a owl:Class .

