@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sc: <https://example.org/sc#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sc:CarrierShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:name ] ;
    sh:targetClass sc:Carrier .

sc:EventShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path sc:ended ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:kind ],
        [ sh:datatype xsd:string ;
            sh:in ( "low" "medium" "high" ) ;
            sh:maxCount 1 ;
            sh:path sc:severity ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path sc:started ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path sc:note ] ;
    sh:targetClass sc:Event .

sc:InvoiceShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:path sc:billed_by ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path sc:anomaly ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path sc:currency ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:amount ],
        [ sh:maxCount 1 ;
            sh:path sc:invoices_for ],
        [ sh:datatype xsd:string ;
            sh:in ( "open" "approved" "paid" "flagged" ) ;
            sh:maxCount 1 ;
            sh:path sc:status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path sc:due ] ;
    sh:targetClass sc:Invoice .

sc:PortShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "APAC" "EMEA" "AMER" ) ;
            sh:maxCount 1 ;
            sh:path sc:region ],
        [ sh:datatype xsd:string ;
            sh:in ( "open" "closed" ) ;
            sh:maxCount 1 ;
            sh:path sc:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:name ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:lat ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:lon ] ;
    sh:targetClass sc:Port .

sc:PurchaseOrderShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path sc:status ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:amount ] ;
    sh:targetClass sc:PurchaseOrder .

sc:ShipmentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:delay_hours ],
        [ sh:maxCount 1 ;
            sh:path sc:ships_to ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:operated_by ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:ref ],
        [ sh:maxCount 1 ;
            sh:path sc:ships_from ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:cargo_value ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:progress ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path sc:eta ],
        [ sh:datatype xsd:string ;
            sh:in ( "planned" "in_transit" "delayed" "arrived" ) ;
            sh:maxCount 1 ;
            sh:path sc:status ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:extra_cost ] ;
    sh:targetClass sc:Shipment .

sc:SupplierShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path sc:country ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:price_index ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:name ] ;
    sh:targetClass sc:Supplier .

sc:WarehouseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "APAC" "EMEA" "AMER" ) ;
            sh:maxCount 1 ;
            sh:path sc:region ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:lon ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sc:name ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path sc:lat ] ;
    sh:targetClass sc:Warehouse .

